# Local development only. Copy to .env; npm run dev:media reads it.
NODE_ENV=development
MEDIA_PORT=3001
SITE_ORIGIN=http://127.0.0.1:5173
MEDIA_READ_ONLY=false
# Development defaults to absolute .media/images and .media/tmp paths.
# Production requires existing absolute sibling directories on one filesystem:
# IMAGES_ROOT=/srv/rental-hub/shared/images
# TEMP_ROOT=/srv/rental-hub/shared/tmp
# SITE_ORIGIN=https://your-domain.example
# NODE_ENV=production
# Production release.json must be next to dist/ and server-dist/.
