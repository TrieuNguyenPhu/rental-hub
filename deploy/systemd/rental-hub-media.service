[Unit]
Description=Rental Hub image service
After=network.target

[Service]
Type=simple
User=rental-hub-media
Group=rental-hub
WorkingDirectory=/srv/rental-hub/current
EnvironmentFile=/etc/rental-hub/media.env
ExecStart=/usr/local/bin/node /srv/rental-hub/current/server-dist/server/main.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=40
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/rental-hub/shared/images /srv/rental-hub/shared/tmp

[Install]
WantedBy=multi-user.target
