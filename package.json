{
  "name": "room-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts server/*.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test:e2e": "playwright test",
    "build:media": "tsc -p server/tsconfig.json",
    "start:media": "node server-dist/server/main.js"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
