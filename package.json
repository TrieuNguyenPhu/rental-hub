{
  "name": "room-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "lint": "oxlint",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "node --experimental-strip-types --test tests/architecture/*.test.ts tests/unit/*.test.ts tests/media/*.test.ts",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "build:media": "tsc -p apps/media/tsconfig.json",
    "start:media": "node .local/build/media/apps/media/src/main.js",
    "dev:media": "node --env-file-if-exists=.env --experimental-strip-types apps/media/src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1151.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
