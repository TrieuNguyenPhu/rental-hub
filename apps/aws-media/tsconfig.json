{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "types": ["node"],
    "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["./src/**/*.ts"]
}
